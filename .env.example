# Pinlon POS Admin: copy to .env.local and fill in.
#
# Sign-in is a tenant ID + slug + token typed on the login page. The slug and the token are managed
# per tenant in the central dashboard (Tenants -> LPMS integration). Nothing secret is built in.
#
# The app only needs to know where each tenant's API lives. Use either or both:

# 1) Explicit list: key = tenant ID typed at sign-in, host = tenant API origin (no trailing slash)
VITE_POS_TENANTS=[{"key":"pinlon","name":"Pinlon (UAT)","host":"https://pinlon-lpms.bimats.com"}]

# 2) Pattern for any tenant ID not in the list; {id} is replaced by the tenant ID
# VITE_TENANT_HOST_TEMPLATE=https://{id}-lpms.bimats.com

# Optional
VITE_SESSION_HOURS=8
