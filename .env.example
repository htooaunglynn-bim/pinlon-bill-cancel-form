# Pinlon POS Admin: copy to .env.local and fill in.
#
# WARNING: Vite compiles every VITE_* value into the public JS bundle. Anyone who can load the
# deployed site can read these values. Only deploy behind Netlify password protection or an IP
# allowlist, and only use UAT credentials unless the site is locked down.

# Dashboard sign-in
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me

# Shared POS bearer token (POS_POINT_PAYMENT_TOKEN in bim-lpms .env)
VITE_POS_TOKEN=

# Tenants (hospitals) the dashboard can target, as a JSON array.
# key: short id, name: label, host: tenant API origin (no trailing slash)
VITE_POS_TENANTS=[{"key":"pinlon","name":"Pinlon (UAT)","host":"https://pinlon-lpms.bimats.com"}]

# Optional
VITE_DEFAULT_TENANT=pinlon
VITE_SESSION_HOURS=8
